# SMM Packages — environment template.
# Copy to .env and fill real values. NEVER commit .env. Keep it outside git,
# outside the webroot in production, permissions 600.

APP_ENV=local
APP_NAME="SMM Packages"
APP_URL=http://localhost/smmpackages/public

# APP_KEY — base64 of 32 random bytes. Master key for AES-256-GCM (Crypto.php).
# Generate: php -r "echo base64_encode(random_bytes(32));"
APP_KEY=base64:CHANGE_ME_GENERATE_A_REAL_KEY

# Database
DB_HOST=localhost
DB_NAME=smmpackages
DB_USER=root
DB_PASS=

# --- SaaS billing gateways (tenant -> HiddenXcel) ---
# USDT / crypto
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
# Mobile money (Tanzania)
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=

# Meta app secret — verify X-Hub-Signature-256 on WhatsApp Cloud API webhooks
META_APP_SECRET=

# Support contact shown on public site
SUPPORT_WHATSAPP_URL=#

# Meta webhook verify token (you set this in the Meta App webhook config)
META_VERIFY_TOKEN=
